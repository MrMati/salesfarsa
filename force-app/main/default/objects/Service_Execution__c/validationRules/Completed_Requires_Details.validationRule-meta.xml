<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata"><fullName>Completed_Requires_Details</fullName><active>true</active><errorConditionFormula>AND(ISPICKVAL(Status__c, "Completed"), OR(ISBLANK(Completed_At__c), ISBLANK(Provider__c), ISBLANK(Property__c), ISBLANK(Service__c)))</errorConditionFormula><errorMessage>Completed service requires property, service, provider and completion timestamp.</errorMessage></ValidationRule>