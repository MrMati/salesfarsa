<?xml version='1.0' encoding='utf-8'?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Complete_Service_Interval</fullName>
    <active>true</active>
    <errorConditionFormula>OR(AND(ISBLANK(Start__c), NOT(ISBLANK(End__c))), AND(NOT(ISBLANK(Start__c)), ISBLANK(End__c)))</errorConditionFormula>
    <errorMessage>Provide both service start and end, or neither.</errorMessage>
</ValidationRule>