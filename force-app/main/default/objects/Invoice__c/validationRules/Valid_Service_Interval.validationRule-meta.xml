<?xml version='1.0' encoding='utf-8'?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Valid_Service_Interval</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Start__c)), NOT(ISBLANK(End__c)), End__c &lt;= Start__c)</errorConditionFormula>
    <errorMessage>Service end must be later than service start.</errorMessage>
</ValidationRule>